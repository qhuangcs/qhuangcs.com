---
import BaseLayout from '../layouts/BaseLayout.astro';

const heroParagraphs = [
	'I have spent much of my career working on large-scale systems at Meta and Kuaishou, across video, compute, storage, and networking. Over time, my work moved from systems research and hands-on engineering to building teams and organizations responsible for infrastructure at scale.',
	'I am now back in the Bay Area, writing code again and learning more about the systems emerging around AI training, inference, and developer tools.',
];

const themes = [
	{
		title: 'Systems',
		description: 'Infrastructure, scale, and reliability.',
	},
	{
		title: 'Leadership',
		description: 'Teams, judgment, and execution.',
	},
	{
		title: 'Learning',
		description: 'New systems, code, and ideas.',
	},
];

const experience = [
	{
		company: 'Meta',
		description:
			'I joined Meta after completing my Ph.D. and worked on the infrastructure behind large-scale video products. Over time, my role grew from systems research and engineering into building and leading teams responsible for video processing, streaming, and compute infrastructure.',
	},
	{
		company: 'Kuaishou',
		description:
			'At Kuaishou, I led engineering organizations across video and audio technology, storage, and network infrastructure. Much of the work focused on supporting continued product growth while improving cost efficiency, reliability, and operational discipline.',
	},
];

const selectedWork = [
	{
		title: 'Video Infrastructure at Meta',
		description:
			'Work on video processing, streaming systems, compute scheduling, and the infrastructure required to operate media products at global scale.',
	},
	{
		title: 'Infrastructure at Kuaishou',
		description:
			'Leadership across video and audio technology, storage, CDN, traffic acceleration, and related platform systems during a period of rapid growth and increasing focus on efficiency and reliability.',
	},
	{
		title: 'Facebook Photo Caching',
		description:
			'Research on caching and storage behavior in Facebook’s production photo infrastructure, developed through collaboration between Cornell and Facebook and published at SOSP 2013.',
	},
];

const publications = [
	{
		title: 'An Analysis of Facebook Photo Caching',
		detail: 'SOSP 2013',
	},
	{
		title: 'An Efficient and Resilient Approach to Filtering and Disseminating Streaming Data',
		detail: 'Middleware 2010',
	},
	{
		title: 'Systems and Algorithms for Large-Scale Content Delivery',
		detail: 'Ph.D. dissertation, Cornell University',
	},
];
---

<BaseLayout
	title="Qi Huang"
	description="Qi Huang builds and leads large-scale systems with calm technical judgment."
>
	<section class="hero" aria-labelledby="hero-title">
		<h1 id="hero-title">Qi Huang</h1>
		<div class="hero-copy">
			{heroParagraphs.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>

	<section class="section themes-section" aria-labelledby="themes-title">
		<h2 id="themes-title">Themes</h2>
		<div class="theme-list">
			{
				themes.map((theme) => (
					<article>
						<h3>{theme.title}</h3>
						<p>{theme.description}</p>
					</article>
				))
			}
		</div>
	</section>

	<section id="experience" class="section" aria-labelledby="experience-title">
		<h2 id="experience-title">Experience</h2>
		<div class="experience-list">
			{
				experience.map((item) => (
					<article class="experience-item">
						<h3>{item.company}</h3>
						<p>{item.description}</p>
					</article>
				))
			}
		</div>
	</section>

	<section id="selected-work" class="section" aria-labelledby="selected-work-title">
		<h2 id="selected-work-title">Selected Work</h2>
		<div class="entry-list">
			{
				selectedWork.map((item) => (
					<article class="entry-item">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))
			}
		</div>
	</section>

	<section class="section section-quiet" aria-labelledby="publications-title">
		<h2 id="publications-title">Selected Publications</h2>
		<div class="publication-list">
			{
				publications.map((publication) => (
					<article class="publication-item">
						<h3>{publication.title}</h3>
						<p>{publication.detail}</p>
					</article>
				))
			}
		</div>
	</section>
</BaseLayout>
