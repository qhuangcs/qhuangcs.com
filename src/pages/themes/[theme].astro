---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { themes } from '../../themes';

export async function getStaticPaths() {
	const notes = await getCollection('notes');
	notes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

	return themes.flatMap((theme) => {
		const entries = notes.filter((note) => note.data.themes.includes(theme.id));
		return entries.length ? [{ params: { theme: theme.id }, props: { theme, entries } }] : [];
	});
}

const { theme, entries } = Astro.props;
---

<BaseLayout title={`${theme.title} | Qi Huang`} description={theme.description}>
	<section class="section notes-page">
		<header>
			<h1>{theme.title}</h1>
			<p>{theme.description}</p>
		</header>
		<ul>
			{entries.map((note) => {
				const date = note.data.date.toISOString().slice(0, 10);
				return (
					<li>
						<a href={`${import.meta.env.BASE_URL}notes/${note.id}/`}>{note.data.title}</a>
						<p><time datetime={date}>{date}</time></p>
					</li>
				);
			})}
		</ul>
	</section>
</BaseLayout>
